PORT=5020
NODE_ENV=development
RUNTIME=local
JWT_SECRET=replace-me-same-as-rorr-backend-api-v2
GRACEFUL_SHUTDOWN_MS=30000
CORS_ORIGINS=https://ai-dev-app.rorr.club,http://localhost:3000

# Redis — ElastiCache (socket.io 어댑터, EC2 이중화 broadcast 동기화)
REDIS_HOST=clustercfg.socket-redis.1ujxfk.use1.cache.amazonaws.com
REDIS_PORT=6379

# Database — Aurora PostgreSQL (rooms / room_members)
# IAM auth 사용 시 DB_PASSWORD는 비우고, 런타임에 aws rds generate-db-auth-token으로 채움.
DB_HOST=socket-server.cwjiw4y08fiq.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=rorrService1!
DB_SSL=true
